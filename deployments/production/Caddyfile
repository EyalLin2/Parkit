# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN by itself.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Beta APK for testers: https://$DOMAIN/download/parkit.apk
	handle_path /download/* {
		root * /srv/download
		header *.apk Content-Type application/vnd.android.package-archive
		file_server
	}

	handle {
		reverse_proxy backend:8000
	}
}
