# Copy to .env next to docker-compose.yml on the server and fill in.
# The server's public name — point its DNS A record at the VM's IP first.
# A free option: a DuckDNS name like parkit.duckdns.org.
DOMAIN=api.example.com

POSTGRES_USER=parkit
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=parkit
# Long random string (e.g. `openssl rand -hex 32`). Never reuse the dev one.
JWT_SECRET=change-me-long-random

WEB_CONCURRENCY=4
RATE_LIMIT_PER_MINUTE=240
SESSION_IDLE_MINUTES=20160

# Sign-in codes — see the setup guide.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ParkIt <parkit.app.il@gmail.com>

SMS_PROVIDER=smsgate
SMSGATE_USER=
SMSGATE_PASSWORD=

# Opens https://DOMAIN/admin/feedback?token=… (tester feedback + crash reports)
ADMIN_TOKEN=change-me-long-random

# Parking-sign reader (Claude vision): console.anthropic.com → API keys.
# Empty = the feature is off.
ANTHROPIC_API_KEY=
