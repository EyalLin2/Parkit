<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stops cloud backup, but on Android 12+ a move to a new
     phone can still copy app data. The session token must not travel with it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="parkit_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="parkit_session.xml" />
    </device-transfer>
</data-extraction-rules>
