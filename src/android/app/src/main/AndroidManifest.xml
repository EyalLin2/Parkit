<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ package visibility: lets us check whether Pango is
         installed before opening it (see PangoLink). -->
    <queries>
        <package android:name="com.unicell.pangoandroid" />
        <package android:name="air.com.cellogroup.Cellopark" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <!-- The parking reminder ("paid from 19:00") — asked for only when the driver sets one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Features.CAR_BLUETOOTH is off, so its permissions (BLUETOOTH with
         maxSdkVersion 30, BLUETOOTH_CONNECT) and the exported CarBluetoothReceiver
         for ACL_CONNECTED / ACL_DISCONNECTED are left out. Add them back with the feature. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="${cleartext}"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkIt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:label="@string/app_name"
            android:theme="@style/Theme.ParkIt.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <!-- Lets the camera app write the full-size report photo into our cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver android:name=".remind.ReminderReceiver" android:exported="false" />
        <receiver android:name=".remind.LeaveSpotReceiver" android:exported="false" />
    </application>
</manifest>
