# Copy this file to .env and adjust if needed. Values below are for
# local development only — never used outside docker-compose.

# Postgres (postgis/postgis image)
POSTGRES_USER=parkit
POSTGRES_PASSWORD=parkit_dev_password
POSTGRES_DB=parkit

# Consumed by the FastAPI backend — host "db" / "redis" are the
# docker-compose service names, resolved via the compose network.
DATABASE_URL=postgresql+asyncpg://parkit:parkit_dev_password@db:5432/parkit
REDIS_URL=redis://redis:6379/0

APP_ENV=local
