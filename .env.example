# Copy this file to .env and adjust if needed. Values below are for
# local development only — never used outside docker-compose.

# Postgres (postgis/postgis image)
POSTGRES_USER=parkit
POSTGRES_PASSWORD=parkit_dev_password
POSTGRES_DB=parkit

# Consumed by the FastAPI backend — host "db" / "redis" are the
# docker-compose service names, resolved via the compose network.
DATABASE_URL=postgresql+asyncpg://parkit:parkit_dev_password@db:5432/parkit
REDIS_URL=redis://redis:6379/0

APP_ENV=local

# --- Phone sign-in -----------------------------------------------------------
# dev = codes are written to the backend log (and shown in the app on a local
# server); twilio = real SMS. Never run anything but APP_ENV=local with "dev".
SMS_PROVIDER=dev
# smsgate (free): the "SMS Gateway for Android" app on your phone → Cloud Server
SMSGATE_USER=
SMSGATE_PASSWORD=
TWILIO_ACCOUNT_SID=
# Prefer an API key (Console → API keys) over the account's Auth Token
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# Sending number (+1…) or a Messaging Service SID (MG…)
TWILIO_FROM=
# Signed out after this many minutes away from the app
SESSION_IDLE_MINUTES=30

# --- Email sign-in -----------------------------------------------------------
# dev = codes go to the backend log; smtp = real email through any SMTP server.
# Free options: Brevo (300/day) smtp-relay.brevo.com:587, or Gmail
# smtp.gmail.com:587 with an app password (Google account → Security).
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Parking-sign reader (Claude vision): console.anthropic.com → API keys.
# Empty = the feature is off.
ANTHROPIC_API_KEY=
